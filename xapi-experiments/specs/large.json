          },
          "inScheme": "https://w3id.org/xapi/cmi5/v1.0",
          "verb": "http://adlnet.gov/expapi/verbs/satisfied",
          "rules": [
            {
              "location": "$.result.score",
              "presence": "excluded"
            },
            {
              "location": "$.result.success",
